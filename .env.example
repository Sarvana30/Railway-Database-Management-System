# MySQL connection string: mysql+pymysql://user:password@host:port/dbname
DATABASE_URL=mysql+pymysql://railway:railway@localhost:3306/railway

# Random secret used to sign the session cookie. Change this in production.
SESSION_SECRET=change-this-to-a-long-random-string

# Minutes a "held" booking stays valid before it's treated as free again
HOLD_DURATION_MINUTES=5

# Minimum layover between connecting trains in the fallback router (minutes)
MIN_LAYOVER_MINUTES=30
